// Raw on-chain quantities are NUMERIC(40,0) (u64 fits; headroom for sums). Prices are NUMERIC(40,18).
// Never store token/SOL amounts as floating point.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & auth ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  referralCode String   @unique
  displayName  String?
  wallets      Wallet[]
}

model Wallet {
  address    String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  sessions   Session[]

  @@index([userId])
}

model Session {
  id            String    @id @default(cuid())
  /// sha256(session token). The raw token only ever exists in the user's cookie.
  tokenHash     String    @unique
  walletAddress String
  wallet        Wallet    @relation(fields: [walletAddress], references: [address], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  ip            String?
  userAgent     String?

  @@index([walletAddress])
  @@index([expiresAt])
}

enum NoncePurpose {
  SIGN_IN
  OTC_ACTION
}

model Nonce {
  value         String       @id
  purpose       NoncePurpose
  walletAddress String?
  createdAt     DateTime     @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([expiresAt])
}

model ReferralAttribution {
  wallet         String   @id
  referrerWallet String
  code           String
  createdAt      DateTime @default(now())

  @@index([referrerWallet])
}

// ───────────────────────────── Tokens & market data ─────────────────────────────

enum MarketVenue {
  PUMP_BONDING_CURVE
  PUMPSWAP
  UNKNOWN
}

model Token {
  mint               String         @id
  tokenProgram       String
  decimals           Int
  name               String
  symbol             String
  imageUrl           String?
  creator            String?
  quoteMint          String         @default("SOL")
  isMayhemMode       Boolean        @default(false)
  isHolderReward     Boolean        @default(false)
  venue              MarketVenue    @default(UNKNOWN)
  complete           Boolean        @default(false)
  poolAddress        String?
  createSignature    String?
  createdSlot        BigInt?
  createdAt          DateTime       @default(now())
  graduatedAt        DateTime?
  lastTradeAt        DateTime?
  launchedViaPlatform Boolean       @default(false)
  /// Marks end-to-end test fixtures (guarded localnet E2E mode). Excluded from every listing.
  isDemo             Boolean        @default(false)
  metadata           TokenMetadata?
  market             MarketState?
  otcOrders          OtcOrder[]
  updatedAt          DateTime       @updatedAt

  @@index([creator])
  @@index([createdAt])
  @@index([venue, complete])
  @@index([lastTradeAt])
  @@index([symbol])
  @@index([isDemo])
}

model TokenMetadata {
  mint        String   @id
  token       Token    @relation(fields: [mint], references: [mint], onDelete: Cascade)
  uri         String
  description String?
  image       String?
  website     String?
  twitter     String?
  telegram    String?
  /// Sanitized subset of the off-chain JSON (never rendered as HTML).
  raw         Json?
  fetchedAt   DateTime @default(now())
  fetchError  String?
}

model MarketState {
  mint                 String      @id
  token                Token       @relation(fields: [mint], references: [mint], onDelete: Cascade)
  venue                MarketVenue
  priceSolPerToken     Decimal     @db.Decimal(40, 18)
  marketCapLamports    Decimal     @db.Decimal(40, 0)
  liquidityLamports    Decimal     @db.Decimal(40, 0)
  virtualSolReserves   Decimal?    @db.Decimal(40, 0)
  virtualTokenReserves Decimal?    @db.Decimal(40, 0)
  realSolReserves      Decimal?    @db.Decimal(40, 0)
  realTokenReserves    Decimal?    @db.Decimal(40, 0)
  bondingProgressBps   Int?
  volume24hLamports    Decimal     @default(0) @db.Decimal(40, 0)
  trades24h            Int         @default(0)
  /// 24h volume in USD from the optional listing-stats source (DexScreener). Listing/display only.
  volume24hUsd         Decimal?    @db.Decimal(24, 2)
  volume24hUsdAt       DateTime?
  /// All-time "global fees paid" by traders (platform + priority + tips + network), from Birdeye. Listing only.
  globalFeesLamports   Decimal?    @db.Decimal(40, 0)
  globalFeesAt         DateTime?
  holderCount          Int?
  slot                 BigInt
  updatedAt            DateTime    @updatedAt

  @@index([marketCapLamports])
  @@index([volume24hLamports])
  @@index([volume24hUsd])
  @@index([globalFeesLamports])
  @@index([bondingProgressBps])
}

enum EventProgram {
  PUMP
  PUMP_AMM
}

enum EventKind {
  CREATE
  TRADE
  COMPLETE
  MIGRATE
  CREATE_POOL
  AMM_BUY
  AMM_SELL
}

enum Commitment {
  CONFIRMED
  FINALIZED
}

model PumpEvent {
  id         String       @id @default(cuid())
  signature  String
  eventIndex Int
  slot       BigInt
  blockTime  DateTime?
  program    EventProgram
  kind       EventKind
  mint       String?
  data       Json
  commitment Commitment   @default(CONFIRMED)
  createdAt  DateTime     @default(now())

  @@unique([signature, eventIndex])
  @@index([mint, slot])
  @@index([commitment, slot])
}

enum TradeSide {
  BUY
  SELL
}

model Trade {
  id               String      @id @default(cuid())
  signature        String
  eventIndex       Int
  mint             String
  venue            MarketVenue
  side             TradeSide
  trader           String
  solAmount        Decimal     @db.Decimal(40, 0)
  tokenAmount      Decimal     @db.Decimal(40, 0)
  priceSolPerToken Decimal     @db.Decimal(40, 18)
  protocolFee      Decimal     @default(0) @db.Decimal(40, 0)
  creatorFee       Decimal     @default(0) @db.Decimal(40, 0)
  slot             BigInt
  blockTime        DateTime
  commitment       Commitment  @default(CONFIRMED)
  isDemo           Boolean     @default(false)

  @@unique([signature, eventIndex])
  @@index([mint, blockTime])
  @@index([trader, blockTime])
  @@index([blockTime])
}

model IndexerCheckpoint {
  stream        String   @id
  lastSlot      BigInt
  lastSignature String?
  updatedAt     DateTime @updatedAt
}

model Launch {
  signature          String   @id
  mint               String   @unique
  creator            String
  initialBuyLamports Decimal  @default(0) @db.Decimal(40, 0)
  initialBuyTokens   Decimal  @default(0) @db.Decimal(40, 0)
  slot               BigInt
  createdAt          DateTime @default(now())

  @@index([creator])
}

// ───────────────────────────── OTC ─────────────────────────────

enum OrderSide {
  BUY
  SELL
}

enum FeeMode {
  BUYER_PAYS
  SELLER_PAYS
  SPLIT
}

enum OrderStatus {
  DRAFT
  OPEN
  NEGOTIATING
  ACCEPTED
  SETTLEMENT_READY
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
  INVALIDATED
  FAILED
}

model OtcOrder {
  id                   String           @id
  /// Unguessable id used in /deal/[publicId] links. Knowing it grants no authority.
  publicId             String           @unique
  orderHash            String           @unique
  version              Int
  environment          String
  network              String
  genesisHash          String
  makerWallet          String
  takerWallet          String?
  tokenMint            String
  token                Token            @relation(fields: [tokenMint], references: [mint])
  tokenProgram         String
  tokenDecimals        Int
  side                 OrderSide
  tokenAmountRaw       Decimal          @db.Decimal(40, 0)
  quoteMint            String
  quoteAmountRaw       Decimal          @db.Decimal(40, 0)
  priceDecimal         Decimal          @db.Decimal(40, 18)
  allowPartialFill     Boolean
  minimumFillAmountRaw Decimal          @db.Decimal(40, 0)
  filledAmountRaw      Decimal          @default(0) @db.Decimal(40, 0)
  platformFeeBps       Int
  feeMode              FeeMode
  metadataVersion      Int
  note                 String?
  nonce                String
  salt                 String
  status               OrderStatus
  statusReason         String?
  /// Signed canonical message the maker's wallet signed (exact bytes as UTF-8).
  signedMessage        String
  signature            String           @unique
  createdAt            DateTime
  expiresAt            DateTime
  receivedAt           DateTime         @default(now())
  cancelledAt          DateTime?
  filledAt             DateTime?
  /// The acceptance (OtcOrderSignature kind=ACCEPT) currently holding this order, if any.
  activeAcceptanceId   String?
  acceptanceExpiresAt  DateTime?
  updatedAt            DateTime         @updatedAt
  parentOrderId        String?
  parentOrder          OtcOrder?        @relation("OrderRevisions", fields: [parentOrderId], references: [id])
  children             OtcOrder[]       @relation("OrderRevisions")
  rootOrderId          String
  rootNegotiationId    String?
  negotiation          OtcNegotiation?  @relation(fields: [rootNegotiationId], references: [id])
  revision             Int
  /// Reference market price captured when the order was received (estimate only).
  refPriceSolPerToken  Decimal?         @db.Decimal(40, 18)
  refPriceAt           DateTime?
  isDemo               Boolean          @default(false)
  signatures           OtcOrderSignature[]
  settlements          OtcSettlement[]

  @@unique([makerWallet, nonce])
  @@index([tokenMint, status, side])
  @@index([makerWallet, status])
  @@index([takerWallet, status])
  @@index([status, expiresAt])
  @@index([rootOrderId])
}

enum SignatureKind {
  ORDER
  ACCEPT
  CANCEL
}

model OtcOrderSignature {
  id            String        @id @default(cuid())
  orderId       String
  order         OtcOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind          SignatureKind
  signer        String
  message       String
  signature     String        @unique
  nonce         String
  fillAmountRaw Decimal?      @db.Decimal(40, 0)
  createdAt     DateTime      @default(now())

  @@unique([signer, kind, nonce])
  @@index([orderId, kind])
}

enum NegotiationStatus {
  OPEN
  AGREED
  SETTLED
  CLOSED
}

model OtcNegotiation {
  id                String            @id @default(cuid())
  rootOrderId       String
  makerWallet       String
  counterpartyWallet String
  status            NegotiationStatus @default(OPEN)
  latestRevision    Int               @default(0)
  latestOrderId     String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  orders            OtcOrder[]

  @@unique([rootOrderId, counterpartyWallet])
  @@index([makerWallet])
  @@index([counterpartyWallet])
}

enum SettlementStatus {
  AWAITING_BUYER_SIGNATURE
  AWAITING_SELLER_SIGNATURE
  READY_TO_SUBMIT
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
  EXPIRED
}

model OtcSettlement {
  id                     String           @id @default(cuid())
  orderId                String
  order                  OtcOrder         @relation(fields: [orderId], references: [id])
  /// Equals orderId while the settlement is live; NULL afterwards. UNIQUE ⇒ at most one live settlement per order.
  activeLock             String?          @unique
  attempt                Int
  acceptanceSignatureId  String
  sellerWallet           String
  buyerWallet            String
  tokenMint              String
  tokenProgram           String
  tokenDecimals          Int
  tokenAmountRaw         Decimal          @db.Decimal(40, 0)
  grossQuoteLamports     Decimal          @db.Decimal(40, 0)
  buyerPaysLamports      Decimal          @db.Decimal(40, 0)
  sellerReceivesLamports Decimal          @db.Decimal(40, 0)
  platformFeeLamports    Decimal          @db.Decimal(40, 0)
  referralFeeLamports    Decimal          @db.Decimal(40, 0)
  referrerWallet         String?
  treasuryWallet         String?
  transferFeeRaw         Decimal          @default(0) @db.Decimal(40, 0)
  netTokenReceivedRaw    Decimal          @db.Decimal(40, 0)
  /// Compiled v0 message bytes. Signatures are only ever verified against these exact bytes.
  messageBytes           Bytes
  /// Exact SettlementTerms (JSON, bigints as strings) the message was compiled from.
  terms                  Json
  messageHash            String           @unique
  blockhash              String
  lastValidBlockHeight   BigInt
  buyerSignature         String?
  sellerSignature        String?
  txSignature            String?          @unique
  status                 SettlementStatus
  failureReason          String?
  slot                   BigInt?
  blockTime              DateTime?
  verifiedAt             DateTime?
  refPriceSolPerToken    Decimal?         @db.Decimal(40, 18)
  refPriceAt             DateTime?
  isDemo                 Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  platformFee            PlatformFee?
  referralPayout         ReferralPayout?

  @@index([orderId])
  @@index([status, createdAt])
  @@index([sellerWallet])
  @@index([buyerWallet])
  @@index([tokenMint, status])
}

model PlatformFee {
  id             String        @id @default(cuid())
  settlementId   String        @unique
  settlement     OtcSettlement @relation(fields: [settlementId], references: [id])
  amountLamports Decimal       @db.Decimal(40, 0)
  treasuryWallet String
  txSignature    String
  createdAt      DateTime      @default(now())
}

model ReferralPayout {
  id             String        @id @default(cuid())
  settlementId   String        @unique
  settlement     OtcSettlement @relation(fields: [settlementId], references: [id])
  referrerWallet String
  amountLamports Decimal       @db.Decimal(40, 0)
  txSignature    String
  createdAt      DateTime      @default(now())

  @@index([referrerWallet])
}

// ───────────────────────────── Activity & ops ─────────────────────────────

enum TxKind {
  LAUNCH
  BUY
  SELL
  OTC_SETTLEMENT
}

enum TxStatus {
  PREPARED
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
}

model TransactionRecord {
  signature String    @id
  kind      TxKind
  wallet    String
  mint      String?
  status    TxStatus
  slot      BigInt?
  blockTime DateTime?
  error     String?
  summary   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([wallet, createdAt])
  @@index([status])
}

enum NotificationType {
  OFFER_RECEIVED
  BID_RECEIVED
  COUNTEROFFER
  OFFER_ACCEPTED
  SIGNATURE_REQUIRED
  TX_SUBMITTED
  TRADE_CONFIRMED
  ORDER_EXPIRED
  ORDER_CANCELLED
  SETTLEMENT_FAILED
}

model Notification {
  id        String           @id @default(cuid())
  wallet    String
  type      NotificationType
  title     String
  body      String
  link      String?
  orderId   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([wallet, readAt, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  /// wallet address, "system", "indexer", or "admin:<wallet>"
  actor      String
  action     String
  entityType String
  entityId   String
  fromStatus String?
  toStatus   String?
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actor, createdAt])
  @@index([action, createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  code      String?
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
