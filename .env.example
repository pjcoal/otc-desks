# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="Desk 404"
APP_SYMBOL="DESK"
# Public origin of the web app. Part of every signed-message domain separator; must be https on mainnet.
APP_URL=http://localhost:3000
# ≥32 random chars: `openssl rand -base64 48`. Required in production.
SESSION_SECRET=
SESSION_TTL_SECONDS=604800
LOG_LEVEL=info

# ─── Data ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://otc:otc@localhost:5432/otc
DATABASE_POOL_SIZE=10
# Required on mainnet (rate limits, locks, live updates). Omit in local dev for an in-memory fallback.
REDIS_URL=redis://localhost:6379

# ─── Solana ──────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
# Server-side RPC (may contain a provider API key; never sent to browsers).
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_FALLBACK_URL=
SOLANA_WS_URL=
# RPC given to browsers for wallet operations. Must NOT contain a private key/secret.
PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Only for localnet (`solana genesis-hash`).
SOLANA_GENESIS_HASH=
# Mainnet safety switch. Leave false until docs/mainnet-checklist.md is complete.
ALLOW_MAINNET=false
# Required ("yes") together with ALLOW_MAINNET=true, after completing docs/mainnet-checklist.md.
MAINNET_CHECKLIST_COMPLETED=
SIMULATE_TRANSACTIONS=true
PRIORITY_FEE_MICROLAMPORTS=0

# ─── OTC economics ───────────────────────────────────────────────────────────
# Wallet that receives OTC platform fees. Must already exist on chain (hold ≥ rent-exempt minimum).
PLATFORM_TREASURY_WALLET=
OTC_PLATFORM_FEE_BPS=50
OTC_FEE_MODE=SELLER_PAYS
# Share of the platform fee paid to the referrer of the fee-paying wallet (bps of the fee).
OTC_REFERRAL_SHARE_BPS=0
OTC_MIN_TTL_SECONDS=300
OTC_MAX_TTL_SECONDS=2592000
OTC_MAX_OPEN_ORDERS_PER_WALLET=50
OTC_ALLOW_FREEZE_AUTHORITY=false

# ─── Storage (token images + metadata) ───────────────────────────────────────
# local (dev only) | s3 | pinata
METADATA_PROVIDER=local
# Pinata JWT when METADATA_PROVIDER=pinata
METADATA_API_KEY=
IPFS_GATEWAY_URL=https://4everland.io/ipfs/
# Comma-separated gateways tried in order when the primary fails (rate limits, outages).
IPFS_FALLBACK_GATEWAYS=https://pump.mypinata.cloud/ipfs/,https://gateway.pinata.cloud/ipfs/
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ─── Operations ──────────────────────────────────────────────────────────────
# Comma-separated wallet addresses allowed into /admin.
ADMIN_WALLETS=
# Optional platform token (no functionality depends on its price).
PLATFORM_TOKEN_MINT=
# Comma-separated ISO country codes to block (uses the CDN country header).
BLOCKED_REGIONS=
# Reverse proxies in front of the app (X-Forwarded-For is read from the right). Vercel/Cloudflare: 1.
TRUSTED_PROXY_HOPS=1
# Indexer: firehose (all Pump activity; fine on devnet) | tracked (only tokens in our DB; for mainnet)
INDEXER_MODE=firehose
# Optional token discovery from Pump.fun's unofficial website API (mainnet only). Seeds lists, names
# and images; prices, balances and settlement always come from chain. Off by default.
PUMP_DISCOVERY_API=false
PUMP_DISCOVERY_API_URL=https://frontend-api-v3.pump.fun
# Optional 24h volume (USD) for listings, mainnet only. Display and list filtering only.
DEXSCREENER_API=false
DEXSCREENER_API_URL=https://api.dexscreener.com
# Mainnet listing rules: coins younger than LISTING_RECENT_HOURS need LISTING_MIN_MCAP_USD market cap;
# older coins need LISTING_MIN_VOLUME_USD of 24h volume. Coins launched here are always listed.
LISTING_RECENT_HOURS=72
LISTING_MIN_MCAP_USD=500000
LISTING_MIN_VOLUME_USD=100000
# Chart-quality rules (need DEXSCREENER_API=true), hiding rugs and faked charts: minimum SOL in the
# coin's pools, liquidity as % of market cap, 24h sells/buys ratio, and maximum 24h price drop (%).
LISTING_MIN_LIQUIDITY_SOL=50
LISTING_MIN_LIQ_MCAP_PCT=1.5
LISTING_MIN_SELL_BUY_RATIO=0.25
LISTING_MAX_DROP_24H_PCT=75
# Listed coins also need this much all-time "global fees paid" (SOL), from Birdeye. Applied only when
# BIRDEYE_API_KEY is set (Business plan or higher). 0 disables the rule.
LISTING_MIN_GLOBAL_FEES_SOL=50
BIRDEYE_API_KEY=
BIRDEYE_API_URL=https://public-api.birdeye.so
# Optional error-monitoring webhook (JSON POST per unhandled error).
ERROR_WEBHOOK_URL=
